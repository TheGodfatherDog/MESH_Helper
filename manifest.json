{
    "manifest_version": 3,
    "name": "МЭШ Помогатор",
    "short_name": "mesh_helper",
    "version": "2.4.2",
    "version_name": "2.4.2 (от 26.10.2026)",
    "description": "Помощник для работы с Моей Школой Московской области (authedu.mosreg.ru) Автор Храмцов Андрей Константинович.",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "*://authedu.mosreg.ru/*"
            ],
            "css": [
                "styles.css"
            ],
            "js": [
                "scripts/scheduleZipper.js",
                "scripts/darkTheme.js",
                "scripts/journalTools.js",
                "scripts/libs/qrious.min.js",
                "scripts/libs/xlsx.full.min.js",
                "scripts/tools.js",
                "scripts/exportPupils.js",
                "scripts/ktpHelper.js",
                "scripts/schedulePDF.js",
                "scripts/selfAnalysis.js",
                "scripts/noHomework.js",
                "scripts/mathSymbols.js",
                "scripts/checkScheduleTeachers.js",
                "scripts/VPRGenerator/vpr.js",
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "permissions": [
        "storage",
        "webRequest"
    ],
    "host_permissions": [
        "*://authedu.mosreg.ru/*"
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "icons/Andrusha.png",
                "icons/Andreyka.jpg",
                "changelog.txt"
            ],
            "matches": [
                "*://authedu.mosreg.ru/*"
            ]
        }
    ],
    "sandbox": {
        "pages": [
            "scripts/VPRGenerator/pythonSandbox.html"
        ]
    }
}